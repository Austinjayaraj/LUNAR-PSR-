# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Other configurations
PORT=8000
HOST=0.0.0.0

# Reports: defaults to automatic local background generation
REPORT_AUTO_GENERATE=true
# Use an absolute path to a private persistent volume in production
REPORT_STORAGE_DIR=./storage/reports
REPORT_JOB_TIMEOUT_SECONDS=300
# Optional n8n orchestration: blank URL keeps local generation
N8N_REPORT_WEBHOOK_URL=
N8N_REPORT_WEBHOOK_SECRET=
REPORT_INTERNAL_TOKEN=
